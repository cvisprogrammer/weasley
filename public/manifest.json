{
  "manifest_version": 3,
  "name": "Brii · Inline commands",
  "version": "0.6.3",
  "minimum_chrome_version": "120",
  "description": "Decode completed text with GPT-4.1-mini through your local bridge. Cloud processing is opt-in.",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "flow-background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "flow-popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:3001;"
  }
}
